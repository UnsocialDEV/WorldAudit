<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Configurations>Debug;Release;AnyCPU</Configurations>
    <VintageStoryApiPath Condition="'$(VintageStoryApiPath)' == '' and '$(VINTAGESTORY_API_PATH)' != ''">$(VINTAGESTORY_API_PATH)</VintageStoryApiPath>
    <VintageStoryApiPath Condition="'$(VintageStoryApiPath)' == '' and Exists('$(APPDATA)\Vintagestory\VintagestoryAPI.dll')">$(APPDATA)\Vintagestory\VintagestoryAPI.dll</VintageStoryApiPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>VintageStoryDirectory</_Parameter1>
      <_Parameter2>$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))</_Parameter2>
    </AssemblyAttribute>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\WorldAudit\WorldAudit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony" HintPath="$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))/Lib/0Harmony.dll" Private="true" />
    <Reference Include="VintagestoryLib" HintPath="$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))/VintagestoryLib.dll" Private="true" />
    <Reference Include="VSSurvivalMod" HintPath="$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))/Mods/VSSurvivalMod.dll" Private="true" />
    <Reference Include="Newtonsoft.Json" HintPath="$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))/Lib/Newtonsoft.Json.dll" Private="true" />
    <Reference Include="protobuf-net" HintPath="$([System.IO.Path]::GetDirectoryName('$(VintageStoryApiPath)'))/Lib/protobuf-net.dll" Private="true" />
    <Reference Include="VintagestoryAPI">
      <HintPath>$(VintageStoryApiPath)</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
